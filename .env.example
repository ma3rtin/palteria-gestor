# Supabase PostgreSQL — Settings → Database → Connection string
# DATABASE_URL: Session pooler (IPv4, puerto 5432 via pooler) — para la app
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
# DIRECT_URL: Direct connection — para migraciones
DIRECT_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"

# NextAuth — generá el secret con: openssl rand -base64 32
AUTH_SECRET="reemplazar-con-string-aleatorio"
# Necesario en Vercel u otros hosts que no sean localhost
AUTH_TRUST_HOST=true
