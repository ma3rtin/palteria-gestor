generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================

enum FormaPago {
  EFECTIVO
  TRANSFERENCIA
  PAGO_SEMANAL
  CAMBIO

  @@map("forma_pago")
}

enum EstadoPago {
  PENDIENTE
  PAGADO
  PARCIAL

  @@map("estado_pago")
}

enum EstadoFactura {
  NO_REQUIERE
  PENDIENTE
  EMITIDA

  @@map("estado_factura")
}

// ==================== USUARIOS ====================

model Usuario {
  id           Int      @id @default(autoincrement()) @map("id_usuario")
  email        String   @unique
  passwordHash String   @map("password_hash")
  nombre       String
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now()) @map("creado_en")

  @@map("usuarios")
}

enum TipoRevendedor {
  COMISION  // Oscar: paltería paga X/caja al revendedor
  MARGEN    // Pato: paltería paga diferencia precio cobrado - precio lista
  DESCUENTO // Puesto: revendedor paga neto con descuento por caja

  @@map("tipo_revendedor")
}

// ==================== CATÁLOGOS ====================

model Zona {
  id       Int       @id @default(autoincrement()) @map("id_zona")
  nombre   String    @unique
  clientes Cliente[]

  @@map("zonas")
}

model Revendedor {
  id            Int                     @id @default(autoincrement()) @map("id_revendedor")
  nombre        String                  @unique
  tipo          TipoRevendedor
  activo        Boolean                 @default(true)
  clientes      Cliente[]
  liquidaciones LiquidacionRevendedor[]
  creadoEn      DateTime                @default(now()) @map("creado_en")

  @@map("revendedores")
}

model LiquidacionRevendedor {
  id               Int        @id @default(autoincrement()) @map("id_liquidacion")
  revendedor       Revendedor @relation(fields: [idRevendedor], references: [id])
  idRevendedor     Int        @map("id_revendedor")
  fechaInicio      DateTime   @db.Date @map("fecha_inicio")
  fechaFin         DateTime   @db.Date @map("fecha_fin")
  descuentoPorCaja Float?     @map("descuento_por_caja")
  montoCalculado   Float      @default(0) @map("monto_calculado")
  montoPagado      Float      @default(0) @map("monto_pagado")
  fechaPago        DateTime?  @db.Date @map("fecha_pago")
  formaPago        FormaPago? @map("forma_pago")
  observaciones    String?
  creadoEn         DateTime   @default(now()) @map("creado_en")

  @@map("liquidaciones_revendedor")
}

model Repartidor {
  id           Int         @id @default(autoincrement()) @map("id_repartidor")
  nombre       String      @unique
  activo       Boolean     @default(true)
  clientes     Cliente[]
  pedidos      Pedido[]
  pagosLocales PagoLocal[]

  @@map("repartidores")
}

model Producto {
  id               Int       @id @default(autoincrement()) @map("id_producto")
  nombre           String
  precioReferencia Float     @default(0) @map("precio_referencia")
  kgPorCaja        Float?    @map("kg_por_caja")
  stockCajas       Float     @default(0) @map("stock_cajas")
  // Fecha en que ingresó este lote — distingue batches con mismo nombre
  fechaIngreso     DateTime? @db.Date @map("fecha_ingreso")
  activo           Boolean   @default(true)
  pedidos          Pedido[]

  @@map("productos")
}

// ==================== CUENTAS CORRIENTES ====================

// Agrupa clientes que pagan en conjunto al cierre de semana (o período)
model CuentaCorriente {
  id            Int              @id @default(autoincrement()) @map("id_cuenta")
  nombre        String           @unique
  // Ej: "LUNES", "SABADO", "CADA 2 SEMANAS" — texto libre por flexibilidad
  diaCobranza   String?          @map("dia_cobranza")
  observaciones String?
  activo        Boolean          @default(true)
  clientes      Cliente[]
  periodos      PeriodoSemanal[]
  creadoEn      DateTime         @default(now()) @map("creado_en")

  @@map("cuentas_corrientes")
}

// Registro de un período de cobro semanal (o por período) para una cuenta
model PeriodoSemanal {
  id            Int             @id @default(autoincrement()) @map("id_periodo")
  cuenta        CuentaCorriente @relation(fields: [idCuenta], references: [id])
  idCuenta      Int             @map("id_cuenta")
  fechaInicio   DateTime        @db.Date @map("fecha_inicio")
  fechaFin      DateTime        @db.Date @map("fecha_fin")
  montoTotal    Float           @default(0) @map("monto_total")
  montoPagado   Float           @default(0) @map("monto_pagado")
  fechaPago     DateTime?       @db.Date @map("fecha_pago")
  formaPago     FormaPago?      @map("forma_pago")
  observaciones String?
  creadoEn      DateTime        @default(now()) @map("creado_en")
  pagosLocales  PagoLocal[]

  @@map("periodos_semanales")
}

// Pago registrado dentro de un período: puede ser por local (idCliente set) o global (idCliente null)
model PagoLocal {
  id            Int            @id @default(autoincrement()) @map("id_pago_local")
  periodo       PeriodoSemanal @relation(fields: [idPeriodo], references: [id])
  idPeriodo     Int            @map("id_periodo")
  // null = pago global que cubre todos los locales de la cuenta
  cliente       Cliente?       @relation(fields: [idCliente], references: [id])
  idCliente     Int?           @map("id_cliente")
  monto         Float
  fechaPago     DateTime       @db.Date @map("fecha_pago")
  // Repartidor que cobró (nullable: puede cobrarlo alguien de la oficina)
  repartidor    Repartidor?    @relation(fields: [idRepartidor], references: [id])
  idRepartidor  Int?           @map("id_repartidor")
  observaciones String?
  creadoEn      DateTime       @default(now()) @map("creado_en")

  @@map("pagos_locales")
}

// ==================== CLIENTES ====================

model Cliente {
  id                Int              @id @default(autoincrement()) @map("id_cliente")
  nombre            String
  direccion         String?
  telefono          String?
  zona              Zona             @relation(fields: [idZona], references: [id])
  idZona            Int              @map("id_zona")
  repartidor        Repartidor?      @relation(fields: [idRepartidor], references: [id])
  idRepartidor      Int?             @map("id_repartidor")
  formaPagoPref     FormaPago        @default(EFECTIVO) @map("forma_pago_pref")
  requiereFactura   Boolean          @default(false) @map("requiere_factura")
  cuentaCorriente   CuentaCorriente? @relation(fields: [idCuentaCorriente], references: [id])
  idCuentaCorriente Int?             @map("id_cuenta_corriente")
  revendedor        Revendedor?      @relation(fields: [idRevendedor], references: [id])
  idRevendedor      Int?             @map("id_revendedor")
  comisionPorCaja   Float?           @map("comision_por_caja")
  activo            Boolean          @default(true)
  observaciones     String?
  pedidos           Pedido[]
  pagosLocales      PagoLocal[]
  creadoEn          DateTime         @default(now()) @map("creado_en")
  actualizadoEn     DateTime         @updatedAt @map("actualizado_en")

  @@map("clientes")
}

// ==================== PEDIDOS ====================

model Pedido {
  id              Int           @id @default(autoincrement()) @map("id_pedido")
  fecha           DateTime      @db.Date
  cliente         Cliente       @relation(fields: [idCliente], references: [id])
  idCliente       Int           @map("id_cliente")
  producto        Producto      @relation(fields: [idProducto], references: [id])
  idProducto      Int           @map("id_producto")
  // Texto libre: PF, SEMI, VERDE, PF-SEMI, 1PF-1SEMI, etc.
  maduracion      String
  cajas           Float
  montoTotal      Float         @map("monto_total")
  formaPago       FormaPago     @map("forma_pago")
  estadoPago      EstadoPago    @default(PENDIENTE) @map("estado_pago")
  montoPagado     Float         @default(0) @map("monto_pagado")
  repartidor      Repartidor?   @relation(fields: [idRepartidor], references: [id])
  idRepartidor    Int?          @map("id_repartidor")
  requiereFactura Boolean       @default(false) @map("requiere_factura")
  estadoFactura   EstadoFactura @default(NO_REQUIERE) @map("estado_factura")
  // true para filas de COBRANZA (cobro de deuda, no entrega)
  esCobro         Boolean       @default(false) @map("es_cobro")
  // true cuando el cambio no tiene cargo (fruta descartada); false = se cobra diferencia de kg
  esReposicion    Boolean       @default(false) @map("es_reposicion")
  observaciones   String?
  creadoEn        DateTime      @default(now()) @map("creado_en")
  actualizadoEn   DateTime      @updatedAt @map("actualizado_en")

  @@map("pedidos")
}
